{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/admin"
    },
    {
      "src": "/api/admin/google/start",
      "dest": "/api/admin/login"
    },
    {
      "src": "/api/admin/google/callback",
      "dest": "/api/admin/login"
    },
    {
      "src": "/api/admin/access-decision",
      "dest": "/api/admin/login"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
